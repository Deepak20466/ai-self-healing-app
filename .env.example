# =============================================================================
# AI-Powered Self-Healing Application — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (only infra dependency) -----------------------------------------
# Created by scripts/bootstrap.sh or scripts/bootstrap.ps1.
DATABASE_URL=postgresql+asyncpg://selfheal:selfheal@localhost:5432/selfheal
# A separate, throwaway database. pytest creates and migrates it automatically
# (the selfheal role needs CREATEDB — bootstrap.sh/.ps1 grants it) and never
# touches DATABASE_URL above. See CLAUDE.md "Test database".
TEST_DATABASE_URL=postgresql+asyncpg://selfheal:selfheal@localhost:5432/selfheal_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- Pod ports (native processes, no containers) ------------------------------
APP_PORT=8001
SENTINEL_PORT=8002
# Sent by this process's own SentinelClient as `Authorization: Bearer <token>`
# so sentinel-pod can attribute the report to a specific monitored app (see
# config/monitored_apps.yaml). Optional -- omit to report unattributed.
SENTINEL_INGEST_TOKEN=target-app-a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
MCP_PORT=8003
HEALER_PORT=8000

# --- AI backend selection -------------------------------------------------------
# AI_BACKEND picks which of seven backends the healer drives fixes through:
#   claude_cli (default, recommended) - local Claude Code CLI, your Claude
#     subscription login, no API key. LIVE-VERIFIED (real PRs opened this way
#     — see README "Proof" section). One-time setup: run `claude` once in
#     this repo and log in interactively.
#   codex_cli  - local OpenAI Codex CLI, your ChatGPT/API login.
#     DOCUMENTED-ONLY, UNTESTED LIVE — see healer/agent_codex.py's module
#     docstring and README's "AI backend" section before using this in
#     anything but a sandboxed local test.
#   gemini_cli - local Google Gemini CLI, your Google account login.
#     Same "documented-only, untested live" caveat — see
#     healer/agent_gemini.py's module docstring.
#   api        - the official `anthropic` SDK, requires ANTHROPIC_API_KEY
#     below and `pip install .[api]`.
#   groq_api   - Groq's free-tier HTTP API (GROQ_API_KEY below).
#     LIVE-VERIFIED (see scripts/check_ai_backends.py).
#   gemini_api - Google Gemini's free-tier HTTP API (GEMINI_API_KEY below).
#     BLOCKED as of 2026-09-29: every real key tried has failed live with a
#     Google-side error (see README/VERIFICATION.md) — kept in the code, not
#     in this project's own default chains.
#   openrouter_api - OpenRouter's free-tier HTTP API (uses ANTHROPIC_API_KEY/
#     ANTHROPIC_MODEL below, since OpenRouter accepts the same key format —
#     see README). LIVE-VERIFIED, including real tool-calling.
# The old USE_CLAUDE_CODE boolean still works as a backwards-compatible
# alias (true -> ai_backend=claude_cli, false -> ai_backend=api) if
# AI_BACKEND isn't set — see core/config.py. New setups should set
# AI_BACKEND directly.
AI_BACKEND=claude_cli
# USE_CLAUDE_CODE=true             # legacy alias, only read if AI_BACKEND is unset

# --- AI fallback chains (optional) -----------------------------------------------
# Ordered, comma-separated backend names to try in order per job/chat message
# (a backend with no key is skipped; a quota/rate-limit/auth error puts it in
# cooldown and moves to the next). Unset = a single-item chain from
# AI_BACKEND/CHAT_BACKEND above. See README "AI fallback chains".
# AI_CHAIN=claude_cli,groq_api,openrouter_api
# CHAT_CHAIN=groq_api,openrouter_api,claude_cli
# CHAT_BACKEND=                    # single-backend alternative to CHAT_CHAIN
BACKEND_COOLDOWN_DEFAULT_SECONDS=3600

# --- Claude Code CLI (AI_BACKEND=claude_cli only) -------------------------------
# CLAUDE_CLI_PATH=                 # leave unset to look up "claude" on PATH
CLAUDE_CLI_TIMEOUT_S=600
CLAUDE_CLI_MAX_TURNS=30
MAX_CLI_CALLS_PER_DAY=50

# --- Codex CLI (AI_BACKEND=codex_cli only; untested live, see above) ------------
# CODEX_CLI_PATH=                  # leave unset to look up "codex" on PATH
CODEX_CLI_TIMEOUT_S=600
CODEX_CLI_MAX_TURNS=30

# --- Gemini CLI (AI_BACKEND=gemini_cli only; untested live, see above) ----------
# GEMINI_CLI_PATH=                 # leave unset to look up "gemini" on PATH
GEMINI_CLI_TIMEOUT_S=600
GEMINI_CLI_MAX_TURNS=30

# --- Anthropic / Claude (API mode only: AI_BACKEND=api) -------------------------
# Requires `pip install .[api]` (anthropic is an optional extra) and a real key.
# ALSO used by AI_BACKEND=openrouter_api / the "openrouter_api" chain entry:
# an OpenRouter API key (https://openrouter.ai/keys) works here too — put it
# in ANTHROPIC_API_KEY and set ANTHROPIC_MODEL to a real OpenRouter model
# slug (openrouter/free is a real, free, tool-calling-capable model — query
# https://openrouter.ai/api/v1/models live before picking a different one;
# don't guess a slug from training data, see CLAUDE.md's Phase 4 log).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: point at a proxy for AI_BACKEND=api specifically (the real
# Anthropic-SDK-format backend, not openrouter_api above, which always talks
# to OpenRouter's own /chat/completions endpoint directly). Leave unset for
# the real Anthropic API. See CLAUDE.md Phase 4 log for OpenRouter free-tier
# rate-limit caveats with the healer's rapid tool-call loop.
ANTHROPIC_BASE_URL=

# --- Groq free-tier HTTP API (AI_BACKEND=groq_api, or in AI_CHAIN/CHAT_CHAIN) ----
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_MODEL=openai/gpt-oss-120b

# --- Gemini free-tier HTTP API (AI_BACKEND=gemini_api, or in AI_CHAIN/CHAT_CHAIN)
# BLOCKED as of 2026-09-29 -- see the AI_BACKEND comment above. Get a free
# key: https://aistudio.google.com/apikey if you want to retry it yourself;
# since 2026-05-28, AI Studio issues "auth keys" starting with "AQ." (the
# legacy "AIzaSy..." format is being phased out) -- both are sent as the
# x-goog-api-key header, see README. A short-lived Google OAuth *access*
# token pasted in here (different from an AI Studio-issued key) will still
# 401.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash

# --- GitHub --------------------------------------------------------------------
# Token scopes required: repo, workflow, pull_requests
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Optional: comma-separated GitHub owners/orgs connect-a-repo may register
# (on top of the always-required push-access check). Empty = no restriction.
ALLOWED_REPO_OWNERS=

# --- Auth ------------------------------------------------------------------
# Single admin account. Generate the hash with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# --- Webhooks (sentinel-pod CI ingest) ------------------------------------
HEALER_WEBHOOK_SECRET=change-me-to-a-long-random-string
HEALER_WEBHOOK_URL=http://localhost:8002/webhooks/ci
PUBLIC_URL=http://localhost:8002

# --- Cost control ------------------------------------------------------------
MAX_TOKENS_PER_JOB=150000
DAILY_BUDGET_USD=2.00
CHAT_DAILY_BUDGET_USD=1.00

# --- Safety guardrails ---------------------------------------------------------
# true: PR auto-merges once all CI checks pass. false: waits for human approval.
AUTO_MERGE=false

# --- Cloud deployment (used by GitHub Actions deploy.yml / provision_vm.sh) ----
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=

# --- Notifications (optional; skipped silently if unset) -----------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
