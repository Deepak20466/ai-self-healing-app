# =============================================================================
# AI-Powered Self-Healing Application — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (only infra dependency) -----------------------------------------
# Created by scripts/bootstrap.sh or scripts/bootstrap.ps1.
DATABASE_URL=postgresql+asyncpg://selfheal:selfheal@localhost:5432/selfheal
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- Pod ports (native processes, no containers) ------------------------------
APP_PORT=8001
SENTINEL_PORT=8002
MCP_PORT=8003
HEALER_PORT=8000

# --- Anthropic / Claude --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub --------------------------------------------------------------------
# Token scopes required: repo, workflow, pull_requests
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Auth ------------------------------------------------------------------
# Single admin account. Generate the hash with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# --- Webhooks (sentinel-pod CI ingest) ------------------------------------
HEALER_WEBHOOK_SECRET=change-me-to-a-long-random-string
HEALER_WEBHOOK_URL=http://localhost:8002/webhooks/ci
PUBLIC_URL=http://localhost:8002

# --- Cost control ------------------------------------------------------------
MAX_TOKENS_PER_JOB=150000
DAILY_BUDGET_USD=2.00
CHAT_DAILY_BUDGET_USD=1.00

# --- Safety guardrails ---------------------------------------------------------
# true: PR auto-merges once all CI checks pass. false: waits for human approval.
AUTO_MERGE=false

# --- Cloud deployment (used by GitHub Actions deploy.yml / provision_vm.sh) ----
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=

# --- Notifications (optional; skipped silently if unset) -----------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
