[Unit]
Description=selfheal sentinel-pod (error capture, silent-bug detection, CI webhook)
After=network.target postgresql.service selfheal-app.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/selfheal/current
EnvironmentFile=/opt/selfheal/shared/.env
ExecStart=/opt/selfheal/current/.venv/bin/uvicorn sentinel.app:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=3
MemoryMax=200M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selfheal

[Install]
WantedBy=multi-user.target
