# SPEC.md CLOUD DEPLOYMENT: auto-HTTPS reverse proxy in front of the 4 pods.
#
# v1.0 is terminal-only: only sentinel-pod's public CI webhook
# (`/webhooks/ci`) is reachable from the internet. app-pod, mcp-pod, AND
# healer-pod all stay on localhost-only ports -- the `selfheal` CLI talks to
# healer-pod directly over localhost (or an SSH tunnel to it), never through
# this reverse proxy. Caddy terminates TLS and gets a cert automatically via
# Let's Encrypt for a real domain.
#
# `scripts/provision_vm.sh` generates the real `/etc/caddy/Caddyfile` from
# this template, substituting an IP-only `:80` address block instead when no
# domain is supplied (Caddy can't issue a TLS cert for a bare IP, and an
# empty site address is invalid Caddyfile syntax, so both cases can't live
# in one static file with a plain env-var substitution -- see that script).
# This checked-in copy is the domain-based version, for reference/review.

example.com {
	encode gzip

	# sentinel-pod: only the CI webhook and its own healthz are public.
	handle /webhooks/ci {
		reverse_proxy 127.0.0.1:8002
	}
	handle /sentinel-healthz {
		reverse_proxy 127.0.0.1:8002/healthz
	}

	# Everything else (including healer-pod) is intentionally not proxied.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/selfheal-access.log
	}
}
