[Unit]
Description=selfheal healer-pod (autonomous fix worker + AI chat/dashboard UI)
After=network.target postgresql.service selfheal-mcp.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/selfheal/current
EnvironmentFile=/opt/selfheal/shared/.env
ExecStart=/opt/selfheal/current/.venv/bin/uvicorn healer.app:asgi_app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# Higher headroom than the other pods: this process also spawns the Claude
# Code CLI as a child subprocess in free mode (SPEC.md AI BACKENDS).
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selfheal

[Install]
WantedBy=multi-user.target
